# ---- Server ----
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=dev
LOG_LEVEL=INFO

# ---- Database ----
# Postgres URL used by the app and alembic
DATABASE_URL=postgresql+psycopg2://context_core:context_core@localhost:5432/context_core

# ---- Auth ----
# Long random strings. NEVER commit real values.
JWT_SECRET=change-me-to-a-long-random-string-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=43200
# Shared secret required once at /auth/device/register to enroll a new device.
DEVICE_REGISTRATION_SECRET=change-me-too

# ---- Groq ----
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1

# ---- Worker ----
WORKER_POLL_INTERVAL_SECONDS=5
WORKER_MAX_ATTEMPTS=5

# ---- Context compiler ----
CONTEXT_DEFAULT_TOKEN_BUDGET=4000
